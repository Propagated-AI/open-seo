# Copy to a Git-ignored .env file on your own computer.
# Management tokens stay local; manage.py sends only approved app bindings.
RENDER_API_KEY=
CLOUDFLARE_API_TOKEN=
DATAFORSEO_API_KEY=

# Set by cloudflare_setup.py provision, or copy from your Access application.
TEAM_DOMAIN=
POLICY_AUD=
AUTH_MODE=cloudflare_access

# manage.py generates these when absent during service creation.
RENDER_MAINTENANCE_KEY=
BETTER_AUTH_SECRET=

OPENSEO_TELEMETRY_DISABLED=1
DO_NOT_TRACK=1
VITE_SHOW_DEVTOOLS=false
CLOUDFLARE_INCLUDE_PROCESS_ENV=true
PORT=10000

# Optional integrations. Leave empty unless you intend to configure them.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
