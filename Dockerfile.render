FROM caddy:2.11.4 AS gateway
# Render drops CAP_NET_BIND_SERVICE. Remove the image's file capability so
# execve can start Caddy; this gateway listens only on unprivileged port 10000.
RUN setcap -r /usr/bin/caddy && test -z "$(getcap /usr/bin/caddy)"
FROM node:22-bookworm
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.30.1 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches ./patches
RUN pnpm install --frozen-lockfile
COPY . .
# Only public build configuration belongs here; API credentials arrive at runtime.
ENV AUTH_MODE=cloudflare_access VITE_SHOW_DEVTOOLS=false OPENSEO_TELEMETRY_DISABLED=1
RUN pnpm build && cp .wrangler/deploy/config.json dist/render-deploy-config.json
COPY --from=gateway /usr/bin/caddy /usr/local/bin/caddy
ENV CLOUDFLARE_INCLUDE_PROCESS_ENV=true PORT=10000
EXPOSE 10000
CMD ["node", "deploy/render/supervisor.mjs"]
